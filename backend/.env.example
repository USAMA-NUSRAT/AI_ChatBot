# Primary provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback provider (used if Anthropic fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MAX_TOKENS=1024
CORS_ORIGINS=http://localhost:5173

# --- RAG ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/chatbot
# Changing these two requires re-uploading all documents
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_SCORE=0.5
